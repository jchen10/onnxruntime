// Re-quantize 4-bit B weights to i8 and prepack into 32x32 tiles for i8 DPAS path.
// Re-quantizes with block_size_k=128 (may differ from original 4-bit quantization block size).
// Single-pass implementation: uses subgroupMax to find per-row max|dequant| without
// a separate scan pass, halving global memory reads vs the 2-pass approach.
// Hardcoded for kBlockSizeK=128, SIMD=16 (all 16 lanes active, no idle threads).
//
// Input:  B [N, K/8] as u32 (4-bit packed, 8 values per u32), component=4
// Input:  scales_b [N, K/orig_block_size] as f16
// Input:  zero_points (optional, 4-bit packed)
// Output: B_i8 prepacked [num_tiles_n * num_tiles_k * 256] as i32 (32x32 tiles, each 256 i32).
//         Within a tile the data is row-major (K slow, N fast): the 32x32 tile is split into two
//         16-wide N halves (matching the two subgroup_matrix_right<i8,16,32> loads in the matmul),
//         and within a half element(k, n_local) lives at i8 offset n_block*512 + k*16 + n_local.
//         One output i32 therefore packs 4 consecutive N values for the same K. This is exactly
//         what subgroupMatrixLoad expects for col_major=false, stride=kSgMatN(16).
//
// Logical layout (input): B[N][K] row-major, one row per N
//   Example: kBlockSizeK=128, kTileN=32, kTileK=32
//
//         K=0        K=31   K=32        K=63   K=64      K=95   K=96      K=127
//   N=0  [b0_0  ... b0_31 | b0_32  ... b0_63 | b0_64 ...b0_95 | b0_96 ...b0_127]
//   N=1  [b1_0  ... b1_31 | b1_32  ... b1_63 | b1_64 ...b1_95 | b1_96 ...b1_127]
//   ...       tile_k=0          tile_k=1          tile_k=2          tile_k=3
//   N=31 [b31_0 ...b31_31 | b31_32 ...b31_63 | b31_64...b31_95| b31_96...b31_127]
//
// Physical layout (output): tiles stored sequentially, tile index = tile_n * num_k_tiles + tile_k.
//   Each 32x32 tile (256 i32) is two 16-wide N halves, each stored row-major (K slow, N fast):
//     i32 within tile = n_block*128 + k_in_tile*4 + (n_local/4)
//     i32 = pack4xi8(B[k][n_base+0], B[k][n_base+1], B[k][n_base+2], B[k][n_base+3])
//   so consecutive i32 along a K row step through N, and consecutive K rows are 4 i32 apart.
//
//   Thread mapping (kBlockSizeK=128, SIMD=16): lane local_idx owns K-chunk
//   [local_idx*8 .. local_idx*8+7] of every N-row. N is walked in groups of 4 so each lane can
//   pack the 4 N-rows of a group into one i32 per K value (8 i32 per group, 8 groups => 64 i32/lane).
//
// Output: scales_b prepacked [num_tiles_n * num_blocks_k * 32] as f16
//         (tile_n * num_blocks_k + block_k) * kTileN + n
//
// Workgroup: 16 threads (1 subgroup of SIMD=16). All lanes active.
//   subgroupMax reduces 16 per-lane max|dequant| → per-N-row block-wide max in one operation.
// Dispatch: (ceil(N/32), K/128, 1)

#param has_zero_points
#param has_weight_idx
#param has_weight_idx_indirect
#param n_bits
#param output_type_i32

#use .getByOffset .setByOffset

#include "quantization/matmul_nbits_zero_pt.wgsl.template"

const kTileN: u32 = 32;
const kTileK: u32 = 32;
const kBlockSizeK: u32 = 128u;
const kSimdWidth: u32 = 16u;
const kTilesPerBlock: u32 = kBlockSizeK / kTileK;          // 4 K-tiles per scale block
const kQ4ValuesPerU32: u32 = 8u;                           // 8 x 4-bit values packed per u32 (input format)
const kValuesPerChunk: u32 = 8u;                           // each thread dequantizes 8 K values (one u32 of input)
const kNGroup: u32 = 4u;                                   // 4 consecutive N packed into one output i32
const kSgMatN: u32 = 16u;                                  // N width of one subgroup_matrix_right<i8,16,32> block
const kI32PerTile: u32 = kTileN * kTileK / 4u;             // 256 i32 per 32x32 tile (4 i8 per i32)

fn pack4xi8(v0: i32, v1: i32, v2: i32, v3: i32) -> i32 {
    return (v0 & 0xFF) | ((v1 & 0xFF) << 8) | ((v2 & 0xFF) << 16) | ((v3 & 0xFF) << 24);
}

$MAIN {
    let tile_n = workgroup_id.x;
    let block_k = workgroup_id.y;
    let num_k_tiles = uniforms.K / kTileK;
    let num_blocks_k = uniforms.K / kBlockSizeK;
    let k_start = block_k * kBlockSizeK;
    let first_tile_k = block_k * kTilesPerBlock;

    // Weight index offset for batched weights
#if has_weight_idx
#if has_weight_idx_indirect
    let actual_weight_idx = weight_index_indirect[uniforms.weight_idx];
#else
    let actual_weight_idx = uniforms.weight_idx;
#endif
    let b_offset = actual_weight_idx * uniforms.K * uniforms.N / kQ4ValuesPerU32;
    let scale_b_offset = actual_weight_idx * uniforms.N * uniforms.orig_blocks_per_col;
#else
    const b_offset: u32 = 0;
    const scale_b_offset: u32 = 0;
#endif

    // This lane owns K-chunk [k_pos, k_pos+8) of every N-row in the block.
    let k_pos = k_start + local_idx * kValuesPerChunk;
    let orig_block_idx = k_pos / uniforms.orig_block_size;

    // Process N in groups of 4 so that 4 consecutive N pack into one output i32
    // (row-major / col_major=false layout: within a tile N is the fast dimension).
    // All 16 lanes cooperate per N-row, splitting its 128 K-values, so subgroupMax
    // yields the block-wide max for that row.
    for (var ng: u32 = 0u; ng < kTileN; ng += kNGroup) {
        let n_block = ng / kSgMatN;        // which 16-wide N half (0 or 1)
        let n_local_base = ng % kSgMatN;   // 0, 4, 8 or 12 within the half

        // Requantized i8 values (held in the low byte) for the 4 N-rows of this group,
        // one entry per K value in this lane's chunk.
        var q: array<array<i32, kValuesPerChunk>, kNGroup>;

        for (var r: u32 = 0u; r < kNGroup; r++) {
            let global_n = tile_n * kTileN + ng + r;

            var dequant: array<scales_b_element_t, 8>;
            var local_max_abs = scales_b_element_t(0);
            if (global_n < uniforms.N) {
                let orig_scale = scales_b.getByOffset(global_n * uniforms.orig_blocks_per_col + orig_block_idx + scale_b_offset);
                let zero = i32(mm_read_zero(global_n, orig_block_idx, uniforms.N, uniforms.zero_blocks_per_col));

                let packed_idx = (global_n * uniforms.K + k_pos) / kQ4ValuesPerU32 + b_offset;
                let packed_weights = input_b.getByOffset(packed_idx);
                let lo = unpack4xU8(packed_weights & 0x0F0F0F0Fu);
                let hi = unpack4xU8((packed_weights >> 4u) & 0x0F0F0F0Fu);

                dequant[0] = scales_b_element_t(i32(lo[0]) - zero) * orig_scale;
                dequant[1] = scales_b_element_t(i32(hi[0]) - zero) * orig_scale;
                dequant[2] = scales_b_element_t(i32(lo[1]) - zero) * orig_scale;
                dequant[3] = scales_b_element_t(i32(hi[1]) - zero) * orig_scale;
                dequant[4] = scales_b_element_t(i32(lo[2]) - zero) * orig_scale;
                dequant[5] = scales_b_element_t(i32(hi[2]) - zero) * orig_scale;
                dequant[6] = scales_b_element_t(i32(lo[3]) - zero) * orig_scale;
                dequant[7] = scales_b_element_t(i32(hi[3]) - zero) * orig_scale;

                local_max_abs = max(max(max(abs(dequant[0]), abs(dequant[1])), max(abs(dequant[2]), abs(dequant[3]))),
                                    max(max(abs(dequant[4]), abs(dequant[5])), max(abs(dequant[6]), abs(dequant[7]))));
            }

            // Uniform subgroup reduction: block-wide max across all 16 K-chunks of this N-row.
            let block_max_abs = subgroupMax(local_max_abs);
            let new_scale = select(block_max_abs, scales_b_element_t(1), block_max_abs == scales_b_element_t(0));
            let inv_scale = scales_b_element_t(1) / new_scale;

            // Re-quantize from registers (no second global read).
            let packed0 = pack4x8snorm(vec4<f32>(f32(dequant[0] * inv_scale), f32(dequant[1] * inv_scale),
                                                  f32(dequant[2] * inv_scale), f32(dequant[3] * inv_scale)));
            let packed1 = pack4x8snorm(vec4<f32>(f32(dequant[4] * inv_scale), f32(dequant[5] * inv_scale),
                                                  f32(dequant[6] * inv_scale), f32(dequant[7] * inv_scale)));
            q[r][0] = i32((packed0       ) & 0xFFu);
            q[r][1] = i32((packed0 >>  8u) & 0xFFu);
            q[r][2] = i32((packed0 >> 16u) & 0xFFu);
            q[r][3] = i32((packed0 >> 24u) & 0xFFu);
            q[r][4] = i32((packed1       ) & 0xFFu);
            q[r][5] = i32((packed1 >>  8u) & 0xFFu);
            q[r][6] = i32((packed1 >> 16u) & 0xFFu);
            q[r][7] = i32((packed1 >> 24u) & 0xFFu);

            // Write the prepacked per-row scale once (any lane has the reduced value).
            if (local_idx == 0u) {
                let scale_offset = (tile_n * num_blocks_k + block_k) * kTileN + ng + r;
                let out_scale = select(scales_b_element_t(0), new_scale / 127, global_n < uniforms.N);
                prepacked_scales_b.setByOffset(scale_offset, out_scale);
            }
        }

        // Emit 8 output i32, one per K value in this lane's chunk. Each i32 packs the
        // 4 N-rows of this group at the same K (N is the fast dimension, col_major=false).
        for (var j: u32 = 0u; j < kValuesPerChunk; j++) {
            let k_rel = local_idx * kValuesPerChunk + j;   // 0..127 within the block
            let tile_k_in_block = k_rel / kTileK;
            let k_in_tile = k_rel % kTileK;
            let out_tile_idx = tile_n * num_k_tiles + first_tile_k + tile_k_in_block;
            // Within-tile i32 index: N-half selects 128, K row picks 4, N-quad picks the i32.
            let out_within = n_block * 128u + k_in_tile * 4u + n_local_base / 4u;
            output_b.setByOffset(out_tile_idx * kI32PerTile + out_within, pack4xi8(q[0][j], q[1][j], q[2][j], q[3][j]));
        }
    }
}  // MAIN
